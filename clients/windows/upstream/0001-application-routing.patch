+#ifdef _WIN32
+// WinSock APIs accept sockaddr pointers; the casts are required by the OS, not a design flaw.
+// NOLINTBEGIN(cppcoreguidelines-pro-type-reinterpret-cast)
+TEST(ApplicationRoutes, ResolveTcpOwnerWithMatchingRemoteEndpoint) {
+    WSADATA wsa{};
+    ASSERT_EQ(WSAStartup(MAKEWORD(2, 2), &wsa), 0);
+    SOCKET listener = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    SOCKET connection = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    ASSERT_NE(listener, INVALID_SOCKET);
+    ASSERT_NE(connection, INVALID_SOCKET);
+    sockaddr_in remote{};
+    remote.sin_family = AF_INET;
+    remote.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    ASSERT_EQ(bind(listener, reinterpret_cast<const sockaddr *>(&remote), sizeof(remote)), 0);
+    ASSERT_EQ(listen(listener, 1), 0);
+    int length = sizeof(remote);
+    ASSERT_EQ(getsockname(listener, reinterpret_cast<sockaddr *>(&remote), &length), 0);
+    ASSERT_EQ(connect(connection, reinterpret_cast<const sockaddr *>(&remote), sizeof(remote)), 0);
+    sockaddr_in local{};
+    length = sizeof(local);
+    ASSERT_EQ(getsockname(connection, reinterpret_cast<sockaddr *>(&local), &length), 0);
+    auto owner = application_for_connection(
+            reinterpret_cast<const sockaddr *>(&local), reinterpret_cast<const sockaddr *>(&remote), IPPROTO_TCP);
+    remote.sin_port = 0;
+    auto wrong_remote = application_for_connection(
+            reinterpret_cast<const sockaddr *>(&local), reinterpret_cast<const sockaddr *>(&remote), IPPROTO_TCP);
+    closesocket(connection);
+    closesocket(listener);
+    WSACleanup();
+    ASSERT_TRUE(owner);
+    EXPECT_NE(owner->find("test_application_routes"), std::string::npos);
+    EXPECT_FALSE(wrong_remote);
+}
+
+TEST(ApplicationRoutes, ResolveRealUdpOwnerWithoutChangingSystemRouting) {
+    WSADATA wsa{};
+    ASSERT_EQ(WSAStartup(MAKEWORD(2, 2), &wsa), 0);
+    SOCKET socket = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    ASSERT_NE(socket, INVALID_SOCKET);
+    sockaddr_in local{};
+    local.sin_family = AF_INET;
+    local.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    ASSERT_EQ(bind(socket, reinterpret_cast<const sockaddr *>(&local), sizeof(local)), 0);
+    int length = sizeof(local);
+    ASSERT_EQ(getsockname(socket, reinterpret_cast<sockaddr *>(&local), &length), 0);
+    auto owner = application_for_connection(reinterpret_cast<const sockaddr *>(&local), nullptr, IPPROTO_UDP);
+    closesocket(socket);
+    WSACleanup();
+    ASSERT_TRUE(owner);
+    EXPECT_NE(owner->find("test_application_routes"), std::string::npos);
+}
+// NOLINTEND(cppcoreguidelines-pro-type-reinterpret-cast)
+#endif
