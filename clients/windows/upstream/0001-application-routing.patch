+++ b/trusttunnel/test/test_application_routes.cpp
@@ -0,0 +1,190 @@
+#include <gtest/gtest.h>
+
+#include "vpn/trusttunnel/application_routes.h"
+#include "vpn/trusttunnel/config.h"
+#include "vpn/trusttunnel/session_policy.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+using namespace ag;
+
+TEST(SessionPolicy, KeepEstablishedTunnelGuardOnFailureUntilExplicitStop) {
+    EXPECT_TRUE(retain_kill_switch(true, true, false));
+    EXPECT_FALSE(retain_kill_switch(false, true, false));
+    EXPECT_FALSE(retain_kill_switch(true, false, false));
+    EXPECT_FALSE(retain_kill_switch(true, true, true));
+}
+
+TEST(ApplicationRoutes, ValidateFullExecutablePaths) {
+    EXPECT_TRUE(valid_application_path("C:\\Program Files\\Browser\\browser.exe"));
+    EXPECT_TRUE(valid_application_path("D:\\Apps\\BROWSER.EXE"));
+    EXPECT_FALSE(valid_application_path("browser.exe"));
+    EXPECT_FALSE(valid_application_path("\\\\server\\share\\browser.exe"));
+    EXPECT_FALSE(valid_application_path("C:\\Apps\\*\\browser.exe"));
+    EXPECT_FALSE(valid_application_path("C:\\Apps\\..\\browser.exe"));
+    EXPECT_FALSE(valid_application_path("C:\\Apps\\browser.exe\n"));
+    EXPECT_FALSE(valid_application_path("C:\\Apps\\browser.lnk"));
+    EXPECT_FALSE(valid_application_path(std::string("C:\\Apps\\browser.exe\0injected", 28)));
+}
+
+TEST(ApplicationRoutes, MatchFullPathsWithoutCaseOrSlashAmbiguity) {
+    EXPECT_TRUE(application_paths_equal("C:\\Apps\\Browser.EXE", "c:/apps/browser.exe"));
+    EXPECT_TRUE(application_paths_equal("C:\\Apps\\browser.exe", "\\\\?\\C:\\Apps\\browser.exe"));
+    EXPECT_FALSE(application_paths_equal("C:\\Apps\\browser.exe", "D:\\Apps\\browser.exe"));
+    EXPECT_FALSE(application_paths_equal("C:\\Apps\\browser.exe", "C:\\Other\\browser.exe"));
+#ifdef _WIN32
+    EXPECT_TRUE(application_paths_equal("C:\\\xC3\x84pp\\browser.exe", "c:\\\xC3\xA4pp\\browser.exe"));
+#endif
+}
+
+TEST(ApplicationRoutes, MatchByProcessName) {
+    EXPECT_TRUE(valid_process_name("UIS Operator Workplace.exe"));
+    EXPECT_TRUE(valid_process_name("Browser.EXE"));
+    EXPECT_FALSE(valid_process_name("browser"));
+    EXPECT_FALSE(valid_process_name("C:\\Apps\\browser.exe"));
+    EXPECT_FALSE(valid_process_name("app/browser.exe"));
+    EXPECT_FALSE(valid_process_name("a\"b.exe"));
+    EXPECT_TRUE(application_names_equal("UIS Operator WORKPLACE.EXE", "uis operator workplace.exe"));
+    EXPECT_FALSE(application_names_equal("A.exe", "B.exe"));
+    std::vector<ApplicationRule> rules = {{"UIS Operator Workplace.exe", true, VPN_CA_FORCE_REDIRECT},
+            {"D:\\Apps\\direct.exe", false, VPN_CA_FORCE_BYPASS}};
+    EXPECT_EQ(application_route(rules, "c:\\Program Files\\UIS\\uis operator workplace.exe"), VPN_CA_FORCE_REDIRECT);
+    EXPECT_EQ(application_route(rules, "C:\\Deep\\D\\Apps\\direct.exe"), VPN_CA_DEFAULT);
+    EXPECT_EQ(application_route(rules, "C:\\Apps\\other.exe"), VPN_CA_DEFAULT);
+}
+
+TEST(ApplicationRoutes, UnknownOwnershipUsesVpnAndKnownNonMatchesKeepDestinationPolicy) {
+    std::vector<ApplicationRule> rules = {
+            {"C:\\Apps\\direct.exe", false, VPN_CA_FORCE_BYPASS}, {"C:\\Apps\\vpn.exe", false, VPN_CA_FORCE_REDIRECT}};
+    EXPECT_EQ(application_route({}, std::nullopt), VPN_CA_DEFAULT);
+    EXPECT_EQ(application_route(rules, std::nullopt), VPN_CA_FORCE_REDIRECT);
+    EXPECT_EQ(application_route(rules, "c:\\apps\\DIRECT.exe"), VPN_CA_FORCE_BYPASS);
+    EXPECT_EQ(application_route(rules, "C:\\Apps\\vpn.exe"), VPN_CA_FORCE_REDIRECT);
+    EXPECT_EQ(application_route(rules, "C:\\Apps\\other.exe"), VPN_CA_DEFAULT);
+    EXPECT_EQ(application_route(rules, "D:\\Apps\\direct.exe"), VPN_CA_DEFAULT);
+    EXPECT_FALSE(application_for_connection(nullptr, nullptr, IPPROTO_TCP));
+}
+
+static const std::string BASE = R"(
+vpn_mode = "general"
+[endpoint]
+hostname = "vpn.example.com"
+addresses = ["127.0.0.1:443"]
+username = "test-user"
+password = "test-password-123"
+skip_verification = false
+has_ipv6 = false
+upstream_protocol = "http2"
+[listener.socks]
+address = "127.0.0.1:1080"
+)";
+
+TEST(ApplicationRoutes, RejectInvalidConfigRatherThanIgnoringRules) {
+    for (const auto &rule : {"executable = 'browser.exe'\naction = 'direct'",
+                 "executable = 'C:\\Apps\\browser.exe'\naction = 'unknown'",
+                 "executable = 'C:\\Apps\\browser.exe'\naction = 'vpn'\nextra = true"}) {
+        auto parsed = toml::parse(BASE + "\n[[application_rules]]\n" + rule);
+        ASSERT_TRUE(parsed);
+        EXPECT_FALSE(TrustTunnelConfig::build_config(parsed.table()));
+    }
+    auto duplicate = toml::parse(BASE
+            + "\n[[application_rules]]\nexecutable = 'C:\\Apps\\browser.exe'\naction = 'direct'"
+              "\n[[application_rules]]\nexecutable = 'c:\\apps\\BROWSER.exe'\naction = 'vpn'");
+    ASSERT_TRUE(duplicate);
+    EXPECT_FALSE(TrustTunnelConfig::build_config(duplicate.table()));
+    auto valid = toml::parse(BASE + "\n[[application_rules]]\nexecutable = 'C:\\Apps\\browser.exe'\naction = 'direct'");
+    ASSERT_TRUE(valid);
+#ifdef _WIN32
+    auto config = TrustTunnelConfig::build_config(valid.table());
+    ASSERT_TRUE(config);
+    ASSERT_EQ(config->application_rules.size(), 1);
+    EXPECT_EQ(config->application_rules[0].action, VPN_CA_FORCE_BYPASS);
+#else
+    EXPECT_FALSE(TrustTunnelConfig::build_config(valid.table()));
+#endif
+
+    auto by_name =
+            toml::parse(BASE + "\n[[application_rules]]\nprocess_name = 'UIS Operator Workplace.exe'\naction = 'vpn'");
+    ASSERT_TRUE(by_name);
+#ifdef _WIN32
+    auto name_config = TrustTunnelConfig::build_config(by_name.table());
+    ASSERT_TRUE(name_config);
+    ASSERT_EQ(name_config->application_rules.size(), 1);
+    EXPECT_TRUE(name_config->application_rules[0].by_name);
+    EXPECT_EQ(name_config->application_rules[0].executable, "UIS Operator Workplace.exe");
+    EXPECT_EQ(name_config->application_rules[0].action, VPN_CA_FORCE_REDIRECT);
+#else
+    EXPECT_FALSE(TrustTunnelConfig::build_config(by_name.table()));
+#endif
+    auto mixed_both = toml::parse(BASE
+            + "\n[[application_rules]]\nexecutable = 'C:\\Apps\\browser.exe'"
+              "\nprocess_name = 'Browser.exe'\naction = 'direct'");
+    ASSERT_TRUE(mixed_both);
+    EXPECT_FALSE(TrustTunnelConfig::build_config(mixed_both.table()));
+    auto dup_name = toml::parse(BASE
+            + "\n[[application_rules]]\nprocess_name = 'browser.EXE'\naction = 'direct'"
+              "\n[[application_rules]]\nprocess_name = 'Browser.exe'\naction = 'vpn'");
+    ASSERT_TRUE(dup_name);
+    EXPECT_FALSE(TrustTunnelConfig::build_config(dup_name.table()));
+}
