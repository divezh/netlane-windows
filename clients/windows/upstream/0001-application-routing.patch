diff --git a/trusttunnel/src/application_routes.cpp b/trusttunnel/src/application_routes.cpp
new file mode 100644
index 0000000..244a6e6
--- /dev/null
+++ b/trusttunnel/src/application_routes.cpp
@@ -0,0 +1,255 @@
+#include "vpn/trusttunnel/application_routes.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+
+#ifdef _WIN32
+#include <iphlpapi.h>
+#include <windows.h>
+#endif
+
+namespace ag {
+
+static std::string normalized_path(std::string_view path) {
+    if (path.starts_with("\\\\?\\")) {
+        path.remove_prefix(4);
+    }
+    std::string result(path);
+    std::ranges::replace(result, '/', '\\');
+    return result;
+}
+
+bool valid_application_path(std::string_view path) {
+    if (path.size() < 8 || path.size() > 4096 || !std::isalpha(static_cast<unsigned char>(path[0])) || path[1] != ':'
+            || path[2] != '\\' || path.find("\\..\\") != std::string_view::npos
+            || path.find_first_of("\r\n\"<>|?*") != std::string_view::npos
+            || path.find('\0') != std::string_view::npos) {
+        return false;
+    }
+    std::string suffix(path.substr(path.size() - 4));
+    std::ranges::transform(suffix, suffix.begin(), [](unsigned char c) {
+        return static_cast<char>(std::tolower(c));
+    });
+    return suffix == ".exe";
+}
+
+bool valid_process_name(std::string_view name) {
+    if (name.size() < 5 || name.size() > 255 || name.find_first_of("\\/:*?\"<>|\r\n") != std::string_view::npos
+            || name.find('\0') != std::string_view::npos) {
+        return false;
+    }
+    std::string suffix(name.substr(name.size() - 4));
+    std::ranges::transform(suffix, suffix.begin(), [](unsigned char c) {
+        return static_cast<char>(std::tolower(c));
+    });
+    return suffix == ".exe";
+}
+
+static std::string_view file_name(std::string_view path) {
+    size_t slash = path.find_last_of("\\/");
+    return slash == std::string_view::npos ? path : path.substr(slash + 1);
+}
+
+#ifdef _WIN32
+static std::optional<std::wstring> utf16(std::string_view text) {
+    int size =
+            MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text.data(), static_cast<int>(text.size()), nullptr, 0);
+    if (size <= 0) {
+        return std::nullopt;
+    }
+    std::wstring result(size, L'\0');
+    if (MultiByteToWideChar(
+                CP_UTF8, MB_ERR_INVALID_CHARS, text.data(), static_cast<int>(text.size()), result.data(), size)
+            != size) {
+        return std::nullopt;
+    }
+    return result;
+}
+#endif
+
+bool application_paths_equal(std::string_view first, std::string_view second) {
+    std::string a = normalized_path(first);
+    std::string b = normalized_path(second);
+#ifdef _WIN32
+    auto wide_a = utf16(a);
+    auto wide_b = utf16(b);
+    return wide_a && wide_b
+            && CompareStringOrdinal(wide_a->data(), static_cast<int>(wide_a->size()), wide_b->data(),
+                       static_cast<int>(wide_b->size()), TRUE)
+            == CSTR_EQUAL;
+#else
+    return std::ranges::equal(a, b, [](unsigned char x, unsigned char y) {
+        return std::tolower(x) == std::tolower(y);
+    });
+#endif
+}
+
+bool application_names_equal(std::string_view first, std::string_view second) {
+#ifdef _WIN32
+    auto wide_a = utf16(first);
+    auto wide_b = utf16(second);
+    return wide_a && wide_b
+            && CompareStringOrdinal(wide_a->data(), static_cast<int>(wide_a->size()), wide_b->data(),
+                       static_cast<int>(wide_b->size()), TRUE)
+            == CSTR_EQUAL;
+#else
+    return std::ranges::equal(first, second, [](unsigned char x, unsigned char y) {
+        return std::tolower(x) == std::tolower(y);
+    });
+#endif
+}
+
+VpnConnectAction application_route(const std::vector<ApplicationRule> &rules, const std::optional<std::string> &owner) {
+    if (rules.empty()) {
+        return VPN_CA_DEFAULT;
+    }
+    if (!owner) {
+        return VPN_CA_FORCE_REDIRECT;
+    }
+    for (const auto &rule : rules) {
+        bool matches = rule.by_name ? application_names_equal(rule.executable, file_name(*owner))
+                                    : application_paths_equal(rule.executable, *owner);
+        if (matches) {
+            return rule.action;
+        }
+    }
+    return VPN_CA_DEFAULT;
+}
+
+#ifdef _WIN32
+static std::optional<DWORD> connection_owner(const sockaddr *source, const sockaddr *destination, int protocol) {
+    if (source == nullptr || (source->sa_family != AF_INET && source->sa_family != AF_INET6)) {
+        return std::nullopt;
+    }
+    DWORD size = 0;
+    bool tcp = protocol == IPPROTO_TCP;
+    if (!tcp && protocol != IPPROTO_UDP) {
+        return std::nullopt;
+    }
+    auto read = [&](void *data) {
+        return tcp ? GetExtendedTcpTable(data, &size, FALSE, source->sa_family, TCP_TABLE_OWNER_PID_ALL, 0)
+                   : GetExtendedUdpTable(data, &size, FALSE, source->sa_family, UDP_TABLE_OWNER_PID, 0);
+    };
+    if (read(nullptr) != ERROR_INSUFFICIENT_BUFFER || size > 16 * 1024 * 1024) {
+        return std::nullopt;
+    }
+    std::vector<unsigned char> buffer;
+    DWORD status = ERROR_INSUFFICIENT_BUFFER;
+    for (int attempt = 0; attempt < 3 && status == ERROR_INSUFFICIENT_BUFFER; ++attempt) {
+        if (size > 16 * 1024 * 1024) {
+            return std::nullopt;
+        }
+        buffer.resize(size);
+        status = read(buffer.data());
+    }
+    if (status != NO_ERROR) {
+        return std::nullopt;
+    }
+    std::optional<DWORD> owner;
+    bool ambiguous = false;
+    auto observe = [&](DWORD pid) {
+        if (pid == 0 || (owner && *owner != pid)) {
+            ambiguous = true;
+        } else {
+            owner = pid;
+        }
+    };
+    if (source->sa_family == AF_INET) {
+        const auto *src = reinterpret_cast<const sockaddr_in *>(source);
+        const auto *dst = destination && destination->sa_family == AF_INET
+                ? reinterpret_cast<const sockaddr_in *>(destination)
+                : nullptr;
+        if (tcp) {
+            const auto *table = reinterpret_cast<const MIB_TCPTABLE_OWNER_PID *>(buffer.data());
+            for (DWORD i = 0; i < table->dwNumEntries; ++i) {
+                const auto &row = table->table[i];
+                if (row.dwState != MIB_TCP_STATE_LISTEN && row.dwLocalPort == src->sin_port
+                        && row.dwLocalAddr == src->sin_addr.s_addr
+                        && (!dst || (row.dwRemotePort == dst->sin_port && row.dwRemoteAddr == dst->sin_addr.s_addr))) {
+                    observe(row.dwOwningPid);
+                }
+            }
+        } else {
+            const auto *table = reinterpret_cast<const MIB_UDPTABLE_OWNER_PID *>(buffer.data());
+            for (DWORD i = 0; i < table->dwNumEntries; ++i) {
+                const auto &row = table->table[i];
+                if (row.dwLocalPort == src->sin_port
+                        && (row.dwLocalAddr == 0 || row.dwLocalAddr == src->sin_addr.s_addr)) {
+                    observe(row.dwOwningPid);
+                }
+            }
+        }
+    } else {
+        const auto *src = reinterpret_cast<const sockaddr_in6 *>(source);
+        const auto *dst = destination && destination->sa_family == AF_INET6
+                ? reinterpret_cast<const sockaddr_in6 *>(destination)
+                : nullptr;
+        if (tcp) {
+            const auto *table = reinterpret_cast<const MIB_TCP6TABLE_OWNER_PID *>(buffer.data());
+            for (DWORD i = 0; i < table->dwNumEntries; ++i) {
+                const auto &row = table->table[i];
+                if (row.dwState != MIB_TCP_STATE_LISTEN && row.dwLocalPort == src->sin6_port
+                        && std::memcmp(row.ucLocalAddr, &src->sin6_addr, 16) == 0
+                        && (!dst
+                                || (row.dwRemotePort == dst->sin6_port
+                                        && std::memcmp(row.ucRemoteAddr, &dst->sin6_addr, 16) == 0))) {
+                    observe(row.dwOwningPid);
+                }
+            }
+        } else {
+            const auto *table = reinterpret_cast<const MIB_UDP6TABLE_OWNER_PID *>(buffer.data());
+            static constexpr unsigned char ANY[16] = {};
+            for (DWORD i = 0; i < table->dwNumEntries; ++i) {
+                const auto &row = table->table[i];
+                if (row.dwLocalPort == src->sin6_port
+                        && (std::memcmp(row.ucLocalAddr, ANY, 16) == 0
+                                || std::memcmp(row.ucLocalAddr, &src->sin6_addr, 16) == 0)) {
+                    observe(row.dwOwningPid);
+                }
+            }
+        }
+    }
+    return ambiguous ? std::nullopt : owner;
+}
+#endif
+
+std::optional<std::string> application_for_connection(
+        const sockaddr *source, const sockaddr *destination, int protocol) {
+#ifdef _WIN32
+    auto pid = connection_owner(source, destination, protocol);
+    if (!pid) {
+        return std::nullopt;
+    }
+    HANDLE process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, *pid);
+    if (process == nullptr) {
+        return std::nullopt;
+    }
+    std::wstring path(32768, L'\0');
+    DWORD length = static_cast<DWORD>(path.size());
+    BOOL success = QueryFullProcessImageNameW(process, 0, path.data(), &length);
+    CloseHandle(process);
+    if (!success) {
+        return std::nullopt;
+    }
+    int size = WideCharToMultiByte(
+            CP_UTF8, WC_ERR_INVALID_CHARS, path.data(), static_cast<int>(length), nullptr, 0, nullptr, nullptr);
+    if (size <= 0) {
+        return std::nullopt;
+    }
+    std::string result(size, '\0');
+    if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, path.data(), static_cast<int>(length), result.data(), size,
+                nullptr, nullptr)
+            != size) {
+        return std::nullopt;
+    }
+    return normalized_path(result);
+#else
+    (void) source;
+    (void) destination;
+    (void) protocol;
+    return std::nullopt;
+#endif
+}
+
+} // namespace ag
